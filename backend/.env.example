APP_NAME="LearnSpace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
# Where reset-password links point (the SPA). Defaults to APP_URL.
FRONTEND_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# The API is stateless (bearer tokens); nothing here needs database-backed sessions or queues.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# API tokens expire after this many minutes (default 7 days)
SANCTUM_EXPIRATION=10080

# Needed for "forgot password" emails
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Password given to the three starter accounts by `php artisan db:seed`. Set it before seeding, then change the passwords.
SEED_PASSWORD=
