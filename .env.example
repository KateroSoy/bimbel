# Front-end build settings (all optional).

# Base URL of the API. Leave unset in production and development: the SPA calls /api on its own origin
# (Vite proxies /api to the Laravel dev server; on Hostinger .htaccess routes it to api/index.php).
# VITE_API_URL="https://api.example.com/api"

# Where the Vite dev server proxies /api (default http://127.0.0.1:8000)
# VITE_API_PROXY="http://127.0.0.1:8000"
